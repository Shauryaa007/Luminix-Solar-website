# ==============================================================================
# Luminix Solar Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Sheets Integration (Leads Excel / Sheet)
# ------------------------------------------------------------------------------
# You can connect via EITHER Method A (Easiest, 60 seconds) OR Method B (GCP API).

# --- METHOD A: Google Apps Script Webhook (Recommended & Instant) ---
# Create a Google Sheet > Extensions > Apps Script > Paste webhook code > Deploy as Web App.
# GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbx.../exec"

# --- METHOD B: Google Cloud Service Account (Google Sheets API v4) ---
# From your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Service Account Email from Google Cloud Console (shared with Sheet as Editor)
GOOGLE_CLIENT_EMAIL="luminix-leads-writer@your-project-id.iam.gserviceaccount.com"

# Service Account Private Key (keep quotes; include -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: tab name (defaults to "Sheet1" if omitted)
GOOGLE_SHEET_NAME="Sheet1"

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection String (Optional / Secondary Database Persistence)
# ------------------------------------------------------------------------------
# Examples:
# Neon:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase:
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luminix_solar?schema=public"

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/luminix_solar?schema=public"
